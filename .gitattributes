# Keep line endings identical on every platform: several fixtures and manifests pin
# SHA-256 hashes of file bytes, so a Windows checkout must not rewrite them to CRLF.
* text=auto eol=lf
# Windows shell scripts keep CRLF; shell scripts keep LF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh  text eol=lf
